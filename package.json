{
  "name": "hatch3d",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm:build": "cd src/wasm && wasm-pack build --target web --out-dir pkg",
    "wasm:dev": "cd src/wasm && wasm-pack build --target web --out-dir pkg --dev",
    "render": "tsx cli/render.ts",
    "sketch": "tsx cli/sketch.ts",
    "sketch:typecheck": "tsc --project tsconfig.sketch.json",
    "plot-core:build": "npm run build --prefix packages/plot-core",
    "plot-host:build": "npm run plot-core:build && npm run build --prefix packages/plot-host",
    "plot-host:smoke": "npm run plot-host:build && npm run smoke --prefix packages/plot-host",
    "render:list": "tsx cli/render.ts --list",
    "render:info": "tsx cli/render.ts --info",
    "stats": "tsx cli/stats.ts",
    "stats:diff": "tsx cli/stats-diff.ts",
    "patch": "tsx cli/patch.ts",
    "feed": "tsx cli/feed-push.ts",
    "feed:dry": "tsx cli/feed-push.ts --dry-run",
    "feed:presets": "tsx cli/feed-push.ts --list-presets",
    "feed:no-pref": "tsx cli/feed-push.ts --no-preferences",
    "pref:sync": "tsx cli/preference-sync.ts",
    "pref:collect": "tsx cli/preference-sync.ts --collect",
    "pref:learn": "tsx cli/preference-sync.ts --learn",
    "pref:stats": "tsx cli/preference-sync.ts --stats",
    "plot-family:smoke": "npm run plot-host:build && node packages/plot-host/family-smoke.mjs",
    "plot-checkpoint:smoke": "npm run plot-host:build && node --import tsx packages/plot-host/checkpoint-smoke.mjs"
  },
  "dependencies": {
    "@endonny/inksight": "^0.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/three": "^0.183.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.183.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
