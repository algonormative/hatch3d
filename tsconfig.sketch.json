{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["cli/sketch.ts", "cli/sketch/**/*.ts", "src/sketch/**/*.ts", "src/utils/clip.ts", "sketches/civic-weather/**/*.ts", "sketches/fault-choir/**/*.ts", "sketches/hatch3d-2d/**/*.ts", "sketches/hatch3d-3d/**/*.ts"]
}
