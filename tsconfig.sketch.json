{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@hatch3d/plot-core": ["packages/plot-core/src/index.ts"] },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "cli/sketch.ts",
    "cli/finalize.ts",
    "cli/plotter-check.ts",
    "cli/print-queue.ts",
    "cli/art-match.ts",
    "cli/baselines.ts",
    "cli/sheet.ts",
    "cli/sketch/**/*.ts",
    "src/sketch/**/*.ts",
    "src/utils/clip.ts",
    "sketches/civic-weather/**/*.ts",
    "sketches/fault-choir/**/*.ts",
    "sketches/hatch3d-2d/**/*.ts",
    "sketches/hatch3d-3d/**/*.ts",
    "sketches/phase-garden/**/*.ts",
    "sketches/breach-cathedral/**/*.ts",
    "sketches/chamber-bloom/**/*.ts",
    "sketches/load-bearing-silence/**/*.ts",
    "sketches/cloud-advection/**/*.ts",
    "sketches/borrowed-orbits/**/*.ts",
    "sketches/breach-cathedral-tower/**/*.ts",
    "sketches/breach-cathedral-agent/**/*.ts",
    "sketches/breach-tarot/**/*.ts",
    "sketches/mannequin-proof/**/*.ts",
    "sketches/kit/**/*.ts",
    "sketches/breach-cathedral-extended/**/*.ts",
    "sketches/chamber-bloom-foam/**/*.ts",
    "sketches/chamber-bloom-plonk/**/*.ts",
    "sketches/load-bearing-silence-span/**/*.ts",
    "sketches/load-bearing-silence-nova/**/*.ts"
  ]
}
