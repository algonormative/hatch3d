{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "rootDir": "../..",
    "outDir": "dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@hatch3d/plot-core": [
        "packages/plot-core/src/index.ts"
      ]
    }
  },
  "include": [
    "src/index.ts"
  ]
}
